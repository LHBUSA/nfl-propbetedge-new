# History database — environment template.
#
# Copy to a file OUTSIDE the repository (D:\Workers\secrets\) and fill in from
# the history Supabase project once it exists. Nothing here belongs in git, and
# nothing here may point at a database that serves live product: the deployment
# commands refuse the NFL/UFC and MLB/PropTech project refs outright.

# Owner connection — migrations and loading only. Session pooler or direct.
# Never used by the API.
HISTORY_DATABASE_URL=postgresql://pbe_history_owner:REPLACE@db.REPLACE.supabase.co:5432/postgres

# Read-only connection the API uses. Row-level security applies to this role,
# so the surface it sees is whatever app.surface says — defaulting to public.
HISTORY_READER_URL=postgresql://pbe_history_reader:REPLACE@db.REPLACE.supabase.co:6543/postgres

# Required for any command that writes. Deliberately awkward to type.
# HISTORY_DEPLOY_CONFIRM=i-understand-this-writes-to-the-history-database

# Supabase project reference for the history project (not any product project).
HISTORY_SUPABASE_PROJECT_REF=REPLACE

# Cloudflare Hyperdrive id for the reader connection, once the Worker exists.
# wrangler hyperdrive create pbe-history --connection-string "$HISTORY_READER_URL"
HISTORY_HYPERDRIVE_ID=REPLACE
